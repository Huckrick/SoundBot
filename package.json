{
  "name": "soundbot",
  "version": "1.0.4",
  "description": "SoundBot - local-first sound effects library and middleware workspace",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "python scripts/build.py",
    "build:mac": "python scripts/build.py --platform macos",
    "build:win": "python scripts/build.py --platform windows",
    "pack": "python scripts/build.py",
    "postinstall": "electron-builder install-app-deps",
    "clean": "python scripts/build.py --clean"
  },
  "keywords": [
    "electron",
    "audio",
    "sound",
    "manager",
    "ai",
    "pyinstaller"
  ],
  "author": "Huckrick",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.soundbot.app",
    "productName": "SoundBot",
    "copyright": "Copyright © 2026 Huckrick and SoundBot contributors",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "splash.html",
      "assets/*.js",
      "assets/misans.css",
      "assets/fonts/misans/*.ttf",
      "assets/renderer/*.js",
      "assets/soundbot.svg",
      "assets/audio-icon.png",
      "config/audio_capabilities.json",
      "!backend/**",
      "!scripts/**",
      "!**/*.pyc",
      "!**/__pycache__",
      "!**/*.spec",
      "!**/.DS_Store",
      "!backend/dist",
      "!backend/build",
      "!dist-electron",
      "!**/venv",
      "!**/models",
      "!**/.git"
    ],
    "mac": {
      "minimumSystemVersion": "14.0",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "LICENSE"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/SoundBot.txt"
      },
      {
        "from": "docs/credits.md",
        "to": "licenses/SoundBot-CREDITS.md"
      },
      {
        "from": "build/licenses/MiSans-License.pdf",
        "to": "licenses/MiSans-License.pdf"
      },
      {
        "from": "tests/build/licenses/THIRD_PARTY_AUDIO_NOTICES.txt",
        "to": "licenses/THIRD_PARTY_AUDIO_NOTICES.txt"
      },
      {
        "from": "build/licenses",
        "to": "licenses/ffmpeg",
        "filter": ["COPYING.*"]
      },
      {
        "from": "node_modules/electron/dist",
        "to": "licenses/electron",
        "filter": ["LICENSE", "LICENSES.chromium.html"]
      },
      {
        "from": "dist/backend/soundbot-backend",
        "to": "backend/soundbot-backend"
      }
    ],
    "publish": null
  }
}
